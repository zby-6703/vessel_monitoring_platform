# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8010
TZ=Asia/Shanghai

# Local development uses SQLite. Docker Compose overrides this value with MySQL.
DATABASE_URL=sqlite:///./data/vessel_monitor.db
REDIS_URL=redis://localhost:6379/0
REDIS_FRAME_QUEUE=video_stream_queue
REDIS_RESULT_CHANNEL=vessel_inference_results
API_INGEST_TOKEN=replace-with-a-long-random-token
DEMO_MODE=false

# Use cpu for a portable first run. Set cuda only after verifying the GPU runtime.
DEVICE=cpu
DOCKER_DEVICE=cpu

# Docker Compose database credentials. Change all three password values before deployment.
MYSQL_DATABASE=vessel_monitor
MYSQL_USER=vessel
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Batch processing
MAX_UPLOAD_GB=10
TRACK_CONFIRM_HITS=3
TRACK_LOST_SECONDS=2
TRACK_FINISH_SECONDS=8
MAX_TRACK_OBSERVATIONS=300
RETENTION_DAYS=30

# Live monitoring (leave LIVE_STREAM_URL empty when only using offline analysis)
LIVE_CAMERA_ID=camera-01
LIVE_CAMERA_NAME=现场监测点 01
LIVE_STREAM_URL=
LIVE_STREAM_PROTOCOL=HTTP-FLV
# Private backend input (RTSP or direct HTTP video), separate from browser preview.
# Example: rtsp://username:password@192.168.1.100:554/stream1
LIVE_CAPTURE_URL=
LIVE_CAPTURE_FRAME_STEP=3
# Fallback only when the source does not report a valid FPS.
LIVE_CAPTURE_FPS=25
# Explicit real FPS when RTSP reports a wrong rate; 0 uses source metadata.
# The setup utility can obtain this from the selected ONVIF encoder profile.
LIVE_CAPTURE_FPS_OVERRIDE=0
# RTSP interleaved TCP is suitable for remote camera links and TCP tunnels.
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp

# Optional ONVIF services and camera tokens (obtain from camera configuration).
# Keep credentials here; they are never sent to the browser.
# Local setup utility input; discover the real service/profile values below.
CAMERA_ONVIF_DEVICE_URL=
CAMERA_RTSP_PORT=554
CAMERA_ONVIF_PTZ_URL=
CAMERA_ONVIF_IMAGING_URL=
CAMERA_ONVIF_PROFILE_TOKEN=
CAMERA_ONVIF_SOURCE_TOKEN=
CAMERA_ONVIF_USERNAME=
CAMERA_ONVIF_PASSWORD=
# Exact physical magnifications mapped to the camera's native absolute zoom positions.
# Example only: measure your own camera; a normalized position is NOT a zoom ratio.
# CAMERA_ONVIF_ZOOM_CALIBRATION={"1":0.0,"3":0.4}
CAMERA_ONVIF_ZOOM_CALIBRATION=
# Required if the media profile has multiple compatible PTZ configurations.
CAMERA_ONVIF_PTZ_CONFIGURATION_TOKEN=
# Required if the camera declares multiple non-digital absolute zoom spaces.
CAMERA_ONVIF_ZOOM_SPACE_URI=
CAMERA_ONVIF_ZOOM_TIMEOUT=15
# Allowed error as a fraction of the declared native position range.
CAMERA_ONVIF_ZOOM_TOLERANCE=0.005

# ONNX model packages. Paths are relative to the project root.
SHIP_DETECTOR_CONFIG=./models/shipdet_rtdetrv4_s_960x544/deploy_config.yaml
SHIP_DETECTOR_WEIGHTS=./models/shipdet_rtdetrv4_s_960x544/model.onnx
DRAFTFORMER_CONFIG=./models/v120_char_water/deploy_config.yaml
DRAFTFORMER_WEIGHTS=./models/v120_char_water/model.onnx
SHIPNAME_CONFIG=./models/svtrv2parseq_RecShipName/deploy_config.yaml
SHIPNAME_WEIGHTS=./models/svtrv2parseq_RecShipName/model.onnx
